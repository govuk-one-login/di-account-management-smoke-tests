{
  "name": "di-account-management-smoke-tests",
  "version": "1.0.0",
  "type": "module",
  "repository": "git@github.com:govuk-one-login/di-account-management-smoke-tests.git",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "eslint .",
    "check-pretty": "prettier --check .",
    "check-types": "tsc --noEmit",
    "sam-validate": "sam validate --region eu-west-2 --lint -t template.yaml",
    "build": "tsc --project tsconfig.build.json",
    "knip": "knip",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.5.0",
    "knip": "6.25.0",
    "prettier": "3.8.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1102.0"
  }
}
